<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/e99_bg">

    <!-- Animated gradient background matching e99.live sky-motion -->
    <com.estakada99.tv.SkyGradientView
        android:id="@+id/backgroundView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Logo in glass panel — centered -->
    <FrameLayout
        android:id="@+id/logoGlassPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/glass_panel"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/logoView"
            android:src="@drawable/logo"
            android:layout_width="320dp"
            android:layout_height="80dp"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- Status / error text -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="200dp"
        android:text="Connecting..."
        android:textColor="@color/e99_text"
        android:fontFamily="@font/satoshi"
        android:textSize="20sp"
        android:textStyle="bold"
        android:shadowColor="#40000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:visibility="visible" />

    <!-- Play/pause - Google TV compliant Button -->
    <Button
        android:id="@+id/playPauseButton"
        android:layout_width="120dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:text="▶"
        android:textSize="28sp"
        android:textColor="@drawable/button_text_color"
        android:fontFamily="@font/satoshi"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="@drawable/button_focus_selector" />

    <!-- Now playing in glass panel — bottom left -->
    <LinearLayout
        android:id="@+id/nowPlayingContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="28dp"
        android:orientation="vertical"
        android:background="@drawable/glass_panel"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:maxWidth="520dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/showNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/e99_text"
            android:fontFamily="@font/satoshi"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/nowPlayingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Currently playing:"
            android:textColor="@color/e99_text_muted"
            android:fontFamily="@font/satoshi"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/nowPlayingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/e99_text"
            android:fontFamily="@font/satoshi"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Clock in glass panel — bottom right -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/glass_panel"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:elevation="2dp">

        <TextClock
            android:id="@+id/clockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm a"
            android:textColor="@color/e99_text"
            android:fontFamily="@font/satoshi"
            android:textSize="22sp" />
    </FrameLayout>

</FrameLayout>
